generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(ASSISTANT)
  telegramChatId   String?
  theme            Theme     @default(SYSTEM)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  studentsCreated  Student[] @relation("CreatedBy")
  studentsUpdated  Student[] @relation("UpdatedBy")
}

enum Role {
  ADMIN
  ASSISTANT
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model Scholarship {
  id          String    @id @default(cuid())
  name        String
  shortCode   String    @unique
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  batches     BatchScholarship[]
  students    StudentScholarship[]
}

model DiscountType {
  id             String    @id @default(cuid())
  name           String
  description    String?
  discountValue  Float
  isPercentage   Boolean   @default(true)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  students       Student[]
}

model Batch {
  id           String           @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime?
  status       BatchStatus      @default(ACTIVE)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  scholarships BatchScholarship[]
  packages     Package[]
  students     Student[]
}

enum BatchStatus {
  ACTIVE
  CLOSED
}

model BatchScholarship {
  batch         Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId       String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])
  scholarshipId String

  @@id([batchId, scholarshipId])
}

model Package {
  id             String    @id @default(cuid())
  batchId        String
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name           String
  listPrice      Float
  earlyBirdPrice Float?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  students       Student[]
}

model ProgressStage {
  id       String    @id @default(cuid())
  name     String    @unique
  order    Int
  students Student[]
}

model Student {
  id                  String               @id @default(cuid())
  fullName            String
  dob                 DateTime?
  phone               String?
  batchId             String
  batch               Batch                @relation(fields: [batchId], references: [id])
  packageId           String?
  package             Package?             @relation(fields: [packageId], references: [id])
  joiningDate         DateTime             @default(now())
  major               String?
  degree              Degree?
  priceCharged        Float?
  discountTypeId      String?
  discountType        DiscountType?        @relation(fields: [discountTypeId], references: [id])
  progressStageId     String?
  progressStage       ProgressStage?       @relation(fields: [progressStageId], references: [id])
  finalResult         FinalResult          @default(PENDING)
  documentLinks       String[]
  notes               String?
  archived            Boolean              @default(false)
  createdById         String?
  createdBy           User?                @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?                @relation("UpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  scholarships        StudentScholarship[]
  payments            Payment[]
}

enum Degree {
  BACHELOR
  MASTER
  PHD
  EXCHANGE
}

enum FinalResult {
  PENDING
  WON
  REJECTED
}

model StudentScholarship {
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])
  scholarshipId String

  @@id([studentId, scholarshipId])
}

model Payment {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountDue   Float
  dueDate     DateTime
  amountPaid  Float         @default(0)
  paidDate    DateTime?
  status      PaymentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model AppSetting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
}
